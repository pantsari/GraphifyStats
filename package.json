{
  "name": "graphify-stats",
  "displayName": "GraphifyStats",
  "description": "Graphify knowledge graph monitor for the VS Code status bar. One prompt installs, sets up, and configures Graphify through your AI coding agent. See live node/edge counts, community stats, graph health, and recent LLM activity — all at a glance.",
  "version": "1.0.1",
  "publisher": "pantsari",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#7C3AED",
    "theme": "dark"
  },
  "gallery": [
    {
      "path": "./GraphifyStats3.png",
      "caption": "Command palette — One Prompt setup for installing and configuring Graphify"
    },
    {
      "path": "./GraphifyStats.png",
      "caption": "QuickPick command palette with stats, actions, and setup options"
    },
    {
      "path": "./GraphifyStats2.png",
      "caption": "Status bar showing live node count, edge count, trigger time, and graph health"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "graphify",
    "knowledge-graph",
    "codebase-visualization",
    "dependency-graph",
    "code-intelligence",
    "architecture",
    "stats",
    "monitor",
    "status-bar",
    "ai",
    "llm",
    "coding-agent",
    "ai-assistant",
    "anthropic",
    "openai",
    "copilot",
    "agent"
  ],
  "activationEvents": [
    "workspaceContains:graphify-out/graph.json",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "GraphifyStats",
      "properties": {
        "graphify-stats.pollInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "How often (in seconds) to poll graph.json for stat updates and check the configured marker."
        },
        "graphify-stats.activityIndicator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Turn the status bar text green when your LLM signals Graphify activity."
        },
        "graphify-stats.activityIndicator.durationSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 120,
          "description": "How long (in seconds) the status bar stays green after activity is signaled."
        }
      }
    },
    "commands": [
      {
        "command": "graphify-stats.click",
        "title": "GraphifyStats: Open QuickPick"
      },
      {
        "command": "graphify-stats.indicateActivity",
        "title": "GraphifyStats: Indicate Graphify Activity"
      }
    ],
    "keybindings": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pantsari/graphify-stats"
  },
  "bugs": {
    "url": "https://github.com/pantsari/graphify-stats/issues"
  },
  "scripts": {
    "package": "vsce package",
    "prepackage": "npm test && npm run lint",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
